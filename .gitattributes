# ============================================
# Global Settings
# ============================================
# Auto detect text files and normalize line endings to LF
* text=auto eol=lf


# ============================================
# Firmware Files (Arduino/C++)
# ============================================
*.ino  text eol=lf linguist-language=C++
*.cpp  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.S    text eol=lf


# ============================================
# Configurator Files (Rust)
# ============================================
*.rs text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf


# ============================================
# Documentation & Configuration
# ============================================
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
LICENSE text eol=lf
README.md text eol=lf
DEV.md text eol=lf


# ============================================
# Scripts
# ============================================
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf


# ============================================
# Binary Files
# ============================================
# Firmware binaries
*.eep  binary
*.hex  binary
*.bin  binary
*.elf  binary

# Archives
*.zip  binary
*.tar  binary
*.gz   binary

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.ico  binary

# Documents
*.pdf  binary

# Rust binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary


# ============================================
# Generated Files (Linguist)
# ============================================
# Mark generated files/folders so GitHub linguist excludes them
_build/**  linguist-generated export-ignore
sketch/**  linguist-generated export-ignore
_build/**/*.d linguist-generated
